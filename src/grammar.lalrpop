use crate::ast;
use crate::tokens::LexicalError;
use crate::tokens::Token;

grammar;

extern {
  type Location = usize;
  type Error = LexicalError;

  enum Token {
    "program" => Token::KeywordProgram,
    "main" => Token::KeywordMain,
    "print" => Token::KeywordPrint,
    "if" => Token::KeywordIf,
    "else" => Token::KeywordElse,
    "while" => Token::KeywordWhile,
    "do" => Token::KeywordDo,
    "end" => Token::KeywordEnd,
    "cte_int" => Token::CteInt,
    "cte_float" => Token::CteFloat,
    "cte.string" => Token::CteString,
    "var" => Token::KeywordVar,
    "void" => Token::KeywordVoid,
    "id" => Token::Identifier(<String>),
    "int" => Token::Integer(<i64>),
    "float" => Token::Float(<f64>),
    "(" => Token::LParen,
    ")" => Token::RParen,
    "[" => Token::LBraket,
    "]" => Token::RBraket,
    "{" => Token::LBrace,
    "}" => Token::RBrace,
    "=" => Token::AssignSimbol,
    ":" => Token::TwoPoints,
    "!=" => Token::NotEqual,
    ">" => Token::BigerThan,
    "<" => Token::SmallerThan,
    ";" => Token::Semicolon,
    "," => Token::Comma,
    "+" => Token::OperatorAdd,
    "-" => Token::OperatorSub,
    "*" => Token::OperatorMul,
    "/" => Token::OperatorDiv,
  }
}

//Program
pub Program: ast::Program = {
  "program" <id:"id"> ";" <var:Vars> <func:Funcs> "main" <body:Body> "end" => {
      ast::Program { id, vars: Some(var), funcs: Some(func), body }
  },
  "program" <id:"id"> ";" <func:Funcs> "main" <body:Body> "end" => {
      ast::Program { id, vars: None, funcs: Some(func), body }
  },
  "program" <id:"id"> ";" "main" <body:Body> "end" => {
      ast::Program { id, vars: None, funcs: None, body }
  },
}

//Func
pub Funcs: Vec<ast::Func> = {
  "void" <func:Func*> => func,
}

pub Func: ast::Func = {
  <id:"id"> "(" <param:Params> ")" "[" <var:Vars> <body:Body> "]" => {
    ast::Func { id, param, vars: Some(var), body }
  },
  <id:"id"> "(" ")" "[" <var:Vars> <body:Body> "]" => {
    ast::Func { id, param: vec![], vars: Some(var), body }
  },
  <id:"id"> "(" ")" "[" <body:Body> "]" => {
    ast::Func { id, param: vec![], vars: None, body }
  },
}
 
pub Params: Vec<ast::Param> = {
  <first:Param> <rest:Param*> => {
    let mut params = vec![first];
    params.extend(rest);  
    params
  }
}

pub Param: ast::Param = {
  <id:"id"> ":" <param_type:Term> => {
    ast::Param { id, param_type }
  }
}

//Vars
pub Vars: Vec<ast::Vars> = {
  "var" <vardecl:VarDecl*> => vardecl,
}

pub VarDecl: ast::Vars = {
  <id:"id"*> ":" <var_type:Expression> ";" => {
    ast::Vars { id, var_type  }
  },
}

//Body
pub Body: Vec<ast::Statement> = {
  "{" <statement:Statement*> "}" => statement,
}

//Statement
pub Statement: ast::Statement = {
  //Assign
  <id:"id"> "=" <value:Expression> ";" => {
    ast::Statement::Assign(ast::Assign { 
      id, 
      value : Box::new(*value), 
    })
  },
  //condition
  "if" "(" <condition:Expression> ")" "do" <body:Statement> "else" "do" <else_body:Statement> => {
      ast::Statement::Condition(ast::Condition {  
          condition: Box::new(*condition),
          body: Some(Box::new(body)),
          elsebody: Some(Box::new(else_body)),
      })
  },
  //cycle
  "while" "(" <wcondition:Expression> ")" "do" <wbody:Body> ";" => {
      ast::Statement::Cycle(ast::Cycle {  
          wcondition: Box::new(*wcondition),
          wbody: wbody,  // Debe ser Vec<Statement>
      })
  },
  //F_call
  <id:"id"> "(" ")" ";" => {
    ast::Statement::FCall(ast::FCall {  
        id,
        expression: vec![], 
    })
  },
  
  <id:"id"> "(" <first_expression:Expression> <rest:FCallRest*> ")" ";" => {
    let mut exprs = vec![first_expression];
    for item in rest {
      exprs.push(Box::new(item));
    }
    ast::Statement::FCall(ast::FCall {
        id,
        expression: exprs,  
    })
  },

  //print
  "print" <value:Expression> ";" => {
    ast::Statement::Print(ast::Print {  value: *value })
  },
}

pub FCallRest: ast::Expression = {  
  "," <rest:Expression> => *rest,
}

//Expresion
pub Expression: Box<ast::Expression> = {
  #[precedence(level="1")]
  Term,

  #[precedence(level="2")] #[assoc(side="left")]
  <lhs:Expression> "*" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Mul,
      rhs
    })
  },
  <lhs:Expression> "/" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Div,
      rhs
    })
  },

  #[precedence(level="3")] #[assoc(side="left")]
  <lhs:Expression> "+" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Add,
      rhs
    })
  },
  <lhs:Expression> "-" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Sub,
      rhs
    })
  },
    #[precedence(level="4")] #[assoc(side="left")]
  <lhs:Expression> "<" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::GreaterThan,
      rhs
    })
  },
  <lhs:Expression> ">" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::LessThan,
      rhs
    })
  },
}

pub Term: Box<ast::Expression> = {
  <val:"int"> => {
    Box::new(ast::Expression::Integer(val))
  },
  <val:"float"> => {
    Box::new(ast::Expression::Float(val))
  },
  <name:"id"> => {
    Box::new(ast::Expression::Variable(name))
  },
  "(" <e:Expression> ")" => e
}